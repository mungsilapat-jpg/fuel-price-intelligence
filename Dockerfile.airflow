FROM apache/airflow:2.10.5-python3.11

COPY requirements.txt /tmp/requirements.txt

# Project dependencies and dbt live in their own virtualenv so they cannot
# conflict with Airflow's pinned packages. DAG tasks call this venv directly.
RUN python -m venv /opt/airflow/venv \
    && /opt/airflow/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt dbt-core dbt-postgres \
    && mkdir -p /opt/airflow/db
